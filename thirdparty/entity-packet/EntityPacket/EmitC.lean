import EntityPacket.Codec

namespace EntityPacket

/-! # The C codec, emitted from the spec

`fabric-fanout-edge/src/fanout.cpp` has included `gen/xr_grid_entity_packet.h` since it was
written, and its own `CMakeLists.txt` says why it has never built: it needs "the entity packet
codec (codegen, lean-entity-packet)", and *"copying the generated headers here would put one
decision in two places."* Nobody wrote the emitter, so the edge has never compiled.

This is the emitter. Every offset and width comes from `Codec.lean` above rather than being
typed again, which is the whole reason it is emitted: a hand-written C struct beside a Lean
spec is two decisions that agree until one of them is edited. `packet_golden.csv` and the
differential test in `test/` are what turn "emitted from the spec" into a claim about bytes.

Plain C, no dependency beyond `stdint.h`. The consumers are a plane, an edge, and a benchmark;
none of them wants a library to read a hundred bytes.
-/

private def u : Nat → String := toString

/-- Little-endian, byte at a time, and never a `memcpy` of the struct. The struct has padding
    the wire does not, its field order is the compiler's business, and a host that stored
    integers big-endian would put a different hundred bytes on the wire under the same code. -/
private def putGet : String :=
"static inline void xr__pu32(uint8_t *b, uint32_t v) {
\tb[0] = (uint8_t)(v);       b[1] = (uint8_t)(v >> 8);
\tb[2] = (uint8_t)(v >> 16); b[3] = (uint8_t)(v >> 24);
}
static inline uint32_t xr__gu32(const uint8_t *b) {
\treturn (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
}
static inline void xr__pi64(uint8_t *b, int64_t v) {
\tuint64_t u = (uint64_t)v;
\tfor (int i = 0; i < 8; i++) b[i] = (uint8_t)(u >> (i * 8));
}
static inline int64_t xr__gi64(const uint8_t *b) {
\tuint64_t u = 0;
\tfor (int i = 0; i < 8; i++) u |= (uint64_t)b[i] << (i * 8);
\treturn (int64_t)u;
}
static inline void xr__pi16(uint8_t *b, int16_t v) {
\tuint16_t u = (uint16_t)v;
\tb[0] = (uint8_t)(u); b[1] = (uint8_t)(u >> 8);
}
static inline int16_t xr__gi16(const uint8_t *b) {
\treturn (int16_t)((uint16_t)b[0] | ((uint16_t)b[1] << 8));
}
"

/-- The header, as a string. Pure, so `Emit.lean` only has to write it. -/
def cHeader : String :=
  let off (n : Nat) := u n
"/* xr_grid_entity_packet.h -- the 100-byte fabric entity packet, in C.
 *
 * GENERATED by `lake exe packet_emit` in v-sekai-multiplayer-fabric/lean-entity-packet.
 * Do not edit: edit EntityPacket/Codec.lean, which is where the layout is specified and where
 * the Plausible roundtrip properties hold it, then emit again.
 *
 * The wire is fully integral -- no floats anywhere -- so position is int64 absolute
 * micrometres and velocity is an int16 scaled against V_MAX. That is what lets the same
 * hundred bytes be compared byte for byte across Lean, C, C++ and GDScript, which
 * packet_golden.csv is for.
 *
 * SPDX-License-Identifier: MIT
 */
#ifndef XR_GRID_ENTITY_PACKET_H
#define XR_GRID_ENTITY_PACKET_H

#include <stdint.h>

#ifdef __cplusplus
extern \"C\" {
#endif

#define XR_PACKET_SIZE " ++ u SIZE ++ "
#define XR_PACKET_PAYLOAD_OFFSET " ++ u PAYLOAD_OFFSET ++ "
#define XR_PACKET_PAYLOAD_LEN " ++ u PAYLOAD_LEN ++ "

/* The i16 velocity scale, in micrometres per tick. A velocity field means nothing without the
 * scale it was divided by, so it travels with the layout rather than beside it. Same number as
 * PBVH_V_MAX_PHYSICAL_DEFAULT in lean-spatial-oracle's predictive_bvh.h. */
#define XR_PACKET_V_MAX_PHYSICAL_DEFAULT_UM_PER_TICK " ++ u V_MAX_UM_PER_TICK ++ "

/* Where each field sits on the wire. Emitted from Codec.lean's own offsets. */
#define XR_PACKET_OFF_GID " ++ off OFF_GID ++ "
#define XR_PACKET_OFF_POS " ++ off OFF_POS ++ "
#define XR_PACKET_OFF_VEL " ++ off OFF_VEL ++ "
#define XR_PACKET_OFF_HLC " ++ off OFF_HLC ++ "
#define XR_PACKET_OFF_CLASS_OWNER " ++ off OFF_CLASS_OWNER ++ "
#define XR_PACKET_OFF_SUB_INDEX " ++ off OFF_SUB_INDEX ++ "
#define XR_PACKET_OFF_ROT " ++ off OFF_ROT ++ "

typedef struct {
\tuint32_t gid;
\tint64_t pos_um_x, pos_um_y, pos_um_z;
\tint16_t vel_x, vel_y, vel_z;
\tuint32_t hlc;
\tuint32_t class_owner; /* (class << 24) | owner */
\tuint32_t sub_index;
\tint16_t rot_x, rot_y, rot_z; /* swing-twist */
\tuint8_t payload[XR_PACKET_PAYLOAD_LEN];
} xr_grid_entity_packet_t;

" ++ putGet ++ "
/* `out` must have room for XR_PACKET_SIZE bytes. Every byte is written, including the
 * unassigned gap at 36..39, so an encode never leaks whatever was in the caller's buffer. */
static inline void xr_grid_entity_packet_encode(const xr_grid_entity_packet_t *p, uint8_t *out) {
\tfor (int i = 0; i < XR_PACKET_SIZE; i++) out[i] = 0;
\txr__pu32(out + XR_PACKET_OFF_GID, p->gid);
\txr__pi64(out + XR_PACKET_OFF_POS + 0, p->pos_um_x);
\txr__pi64(out + XR_PACKET_OFF_POS + 8, p->pos_um_y);
\txr__pi64(out + XR_PACKET_OFF_POS + 16, p->pos_um_z);
\txr__pi16(out + XR_PACKET_OFF_VEL + 0, p->vel_x);
\txr__pi16(out + XR_PACKET_OFF_VEL + 2, p->vel_y);
\txr__pi16(out + XR_PACKET_OFF_VEL + 4, p->vel_z);
\txr__pu32(out + XR_PACKET_OFF_HLC, p->hlc);
\txr__pu32(out + XR_PACKET_OFF_CLASS_OWNER, p->class_owner);
\txr__pu32(out + XR_PACKET_OFF_SUB_INDEX, p->sub_index);
\txr__pi16(out + XR_PACKET_OFF_ROT + 0, p->rot_x);
\txr__pi16(out + XR_PACKET_OFF_ROT + 2, p->rot_y);
\txr__pi16(out + XR_PACKET_OFF_ROT + 4, p->rot_z);
\tfor (int i = 0; i < XR_PACKET_PAYLOAD_LEN; i++)
\t\tout[XR_PACKET_PAYLOAD_OFFSET + i] = p->payload[i];
}

static inline void xr_grid_entity_packet_decode(const uint8_t *in, xr_grid_entity_packet_t *p) {
\tp->gid = xr__gu32(in + XR_PACKET_OFF_GID);
\tp->pos_um_x = xr__gi64(in + XR_PACKET_OFF_POS + 0);
\tp->pos_um_y = xr__gi64(in + XR_PACKET_OFF_POS + 8);
\tp->pos_um_z = xr__gi64(in + XR_PACKET_OFF_POS + 16);
\tp->vel_x = xr__gi16(in + XR_PACKET_OFF_VEL + 0);
\tp->vel_y = xr__gi16(in + XR_PACKET_OFF_VEL + 2);
\tp->vel_z = xr__gi16(in + XR_PACKET_OFF_VEL + 4);
\tp->hlc = xr__gu32(in + XR_PACKET_OFF_HLC);
\tp->class_owner = xr__gu32(in + XR_PACKET_OFF_CLASS_OWNER);
\tp->sub_index = xr__gu32(in + XR_PACKET_OFF_SUB_INDEX);
\tp->rot_x = xr__gi16(in + XR_PACKET_OFF_ROT + 0);
\tp->rot_y = xr__gi16(in + XR_PACKET_OFF_ROT + 2);
\tp->rot_z = xr__gi16(in + XR_PACKET_OFF_ROT + 4);
\tfor (int i = 0; i < XR_PACKET_PAYLOAD_LEN; i++)
\t\tp->payload[i] = in[XR_PACKET_PAYLOAD_OFFSET + i];
}

#ifdef __cplusplus
}
#endif

#endif
"

end EntityPacket
